DATABASE_URL=postgres://postgres:postgres@localhost:5432/fishstick?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_CONNECT_TIMEOUT=5s
SCHEDULER_INTERVAL=5s
SCHEDULER_BATCH_SIZE=100
SCHEDULER_SHUTDOWN_GRACE=10s
SCHEDULER_HEALTH_ADDRESS=:8081
RELAY_INTERVAL=1s
RELAY_BATCH_SIZE=100
RELAY_LOCK_TTL=30s
RELAY_SHUTDOWN_GRACE=10s
RELAY_RABBIT_URL=amqp://fishstick:fishstick@localhost:5672/
RELAY_EXCHANGE=fishstick
RELAY_QUEUE=fishstick.worker
RELAY_ROUTING_KEY=job.dispatch
RELAY_WORKER_ID=relay-1
WORKER_LEASE_DURATION=60s
WORKER_HEARTBEAT_INTERVAL=15s
WORKER_SHUTDOWN_GRACE=30s
WORKER_RABBIT_URL=amqp://fishstick:fishstick@localhost:5672/
WORKER_EXCHANGE=fishstick
WORKER_QUEUE=fishstick.worker
WORKER_ROUTING_KEY=job.dispatch
WORKER_PREFETCH=1
WORKER_WORKER_ID=worker-1
